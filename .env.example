# Copy this file to .env.local (already gitignored) and fill in your own Supabase project's
# values — Project Settings > API in the Supabase dashboard. VITE_SUPABASE_ANON_KEY is the
# public "anon" key, safe to ship in the frontend (Row Level Security restricts what it can do) —
# never put the "service_role" secret key here or anywhere in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
